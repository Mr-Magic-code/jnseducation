# JnS CRM Backend environment configuration
# Copy this file to .env and fill in real values before running in production.

NODE_ENV=development
PORT=4000

# Database (MySQL / MariaDB via mysql2)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=jnscrm
DATABASE_PASSWORD=change-me
DATABASE_NAME=jnscrm
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# JWT access token secret (must be >= 32 random characters in production)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Registration secret keys (must be >= 32 random characters in production)
SUPER_ADMIN_SECRET_KEY=change-me-super-admin-secret-key
MANAGER_SECRET_KEY=change-me-manager-secret-key

# Optional: restrict Super Admin registration to a company email domain
SUPER_ADMIN_EMAIL_DOMAIN=jnsedu.com

# Allowed frontend origins for CORS / CSRF (comma separated)
FRONTEND_URLS=http://localhost:3000,https://jnsedu.com,https://www.jnsedu.com

# GitHub credentials used by the pages scanner (Super Admin only)
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-github-repo
GITHUB_TOKEN=your-github-personal-access-token

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Body payload limit
BODY_LIMIT=1mb

# HTTP server timeouts (ms)
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=5000

# Trust proxy hop count (set to 0 if not behind a reverse proxy)
TRUST_PROXY=1
