# JnS CRM Backend environment template.
# Copy to .env and replace EVERY placeholder with a real value.
# Never commit a real .env file.

NODE_ENV=development
PORT=4000

# Database (MySQL / MariaDB via mysql2)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=jnscrm
DATABASE_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DATABASE_NAME=jnscrm
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Secrets: generate with `openssl rand -base64 48` (>= 32 chars, unique)
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
CSRF_SECRET=REPLACE_WITH_RANDOM_CSRF_SECRET

# Registration gates. Leave false in production; opt in only temporarily.
ALLOW_SUPER_ADMIN_REGISTRATION=false
ALLOW_MANAGER_REGISTRATION=false

# Registration secret keys (required only when the corresponding flag is true)
SUPER_ADMIN_SECRET_KEY=REPLACE_WITH_RANDOM_SUPER_ADMIN_KEY
MANAGER_SECRET_KEY=REPLACE_WITH_RANDOM_MANAGER_KEY

# Optional: restrict Super Admin registration to a company email domain
SUPER_ADMIN_EMAIL_DOMAIN=jnsedu.com

# Allowed frontend origins for CORS / CSRF (comma separated, https in production)
FRONTEND_URLS=http://localhost:3000,https://jnsedu.com,https://www.jnsedu.com

# GitHub credentials used by the pages scanner (Super Admin only)
GITHUB_OWNER=REPLACE_WITH_GITHUB_OWNER
GITHUB_REPO=REPLACE_WITH_GITHUB_REPO
GITHUB_TOKEN=REPLACE_WITH_GITHUB_TOKEN

# Optional CRM webhook for lead forwarding
CRM_API_URL=
CRM_API_TOKEN=

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Body payload limit
BODY_LIMIT=1mb

# HTTP server timeouts (ms)
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=5000

# Trust proxy hop count (set to 0 if not behind a reverse proxy)
TRUST_PROXY=1
